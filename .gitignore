# ============================
# OUTPUT FILES
# ============================

# Windows executables and object files
*.exe
*.o
*.out
*.pdb
*.ilk

# Directories created during build
build/
*/RelWithDebInfo/
*/MinSizeRel/

# CMake build files
**/CMakeFiles
**/CMakeCache.txt
*.cmake

# Editor-specific files (Windows, Linux, macOS)
Editor/assets/cache
Editor/*.dll
Editor/*.pdb

# Qbit Profiling Output (e.g., JSON reports)
Sandbox/*.json
Editor/*.json

# ============================
# PLATFORM SPECIFIC BUILD FILES
# ============================

# Linux build files
**/Makefile

# Windows Visual Studio Files
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.csproj

# Windows Visual Studio directories
**/.vs/
**/obj/
**/x64/
**/*.dir/

# Logs
*.log
*.recipe
*.tlog

# ============================
# VSCODE (IDE-specific files)
# ============================
.vscode/

# ============================
# DEVELOPING PURPOSES / TEMP FILES
# ============================

# Temporary DLLs for scripting purposes
SandboxProject.dll
Editor/Resources/**/*.dll

# Temporary Files for projects
Editor/SandboxProject/Assets/Scripts/Binaries/Qbit-ScriptCore.dll

# ============================
# Miscellaneous (global exclusions)
# ============================

# IDE-specific files
.idea/
*.sublime-workspace
*.sublime-project

# Node.js dependencies (if applicable)
node_modules/

# Python virtual environments (if applicable)
.env/
.venv/

# macOS system files
.DS_Store

# Linux system files
*~

# Windows system files
Thumbs.db
ehthumbs.db

# ============================
# Temporary Files and Directories
# ============================

# Cache directories
**/.cache/
**/.temp/

# End of cross-platform .gitignore
